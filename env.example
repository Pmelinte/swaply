# Environment Variables pentru Swaply

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Cloudinary Configuration (pentru imagini)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_preset

# HuggingFace AI Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key
NEXT_PUBLIC_HUGGINGFACE_MODEL_CLASSIFICATION=microsoft/DialoGPT-medium
NEXT_PUBLIC_HUGGINGFACE_MODEL_IMAGE=google/vit-base-patch16-224

# OpenAI Alternative (optional)
OPENAI_API_KEY=your_openai_api_key

# Google Maps API (pentru travel suggestions)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_key

# Google Analytics 4 (pentru tracking - optional)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Cron Job Secret (pentru securizarea task-urilor programate)
CRON_SECRET=your_random_secret_key_here

# Cloudinary Configuration
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_upload_preset

# Opțional - pentru development
# DATABASE_URL=postgresql://user:password@host:port/database