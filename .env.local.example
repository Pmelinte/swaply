# Environment Variables pentru Swaply - LOCAL DEVELOPMENT

# Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Configuration - REPLACE WITH YOUR ACTUAL VALUES
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here

# Cloudinary Configuration (pentru imagini)
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_cloudinary_preset

# HuggingFace AI Configuration
HUGGINGFACE_API_KEY=your_huggingface_api_key
NEXT_PUBLIC_HUGGINGFACE_MODEL_CLASSIFICATION=microsoft/DialoGPT-medium
NEXT_PUBLIC_HUGGINGFACE_MODEL_IMAGE=google/vit-base-patch16-224

# OpenAI Alternative (optional)
OPENAI_API_KEY=your_openai_api_key