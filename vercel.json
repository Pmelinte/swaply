{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "functions": {
    "src/app/**/*.tsx": {
      "maxDuration": 30
    }
  },
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://swaply-platform.vercel.app",
    "NEXT_PUBLIC_SUPABASE_URL": "https://demo.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "demo-key-for-testing",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "demo",
    "NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "demo"
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ]
}