{
  "version": 2,
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "installCommand": "npm install",
  "regions": ["fra1"],
  "functions": {
    "src/app/**/*.tsx": {
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        }
      ]
    }
  ],
  "env": {
    "NEXT_PUBLIC_SITE_URL": "https://swaply.vercel.app",
    "NEXT_PUBLIC_SUPABASE_URL": "https://xbqzebgrbcwrmcauzjpe.supabase.co",
    "NEXT_PUBLIC_SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InhicXplYmdyYmN3cm1jYXV6anBlIiwicm9sZSI6ImFub24iLCJpYXQiOjE3MzU3NDE1NzAsImV4cCI6MjA1MTMxNzU3MH0.DmHaBK6VCNqbEMXsXlH2VvuAhfqfMu_3GmZTfp9YR-4",
    "NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME": "dcvfn2yc4",
    "NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET": "swaply_uploads"
  },
  "rewrites": [
    {
      "source": "/loghin",
      "destination": "/login"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    }
  ],
  "redirects": [
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    }
  ]
}